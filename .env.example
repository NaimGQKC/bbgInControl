# Copy to .env (local) or paste into the App Service settings (production). Never commit real values.

# --- General
BASE_URL=https://your-app.azurewebsites.net
DATABASE_URL=postgresql://user:password@host:5432/postgres
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too
ENCRYPTION_KEY=            # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CONTACT_EMAIL=             # shown on the privacy / data deletion pages
ASSISTANT_NAME=Lucía       # the named (openly AI) guide agents talk to during onboarding
OPS_WHATSAPP=              # your mobile: gets a WhatsApp when an agent presses "Necesito ayuda"

# --- Modes: live | fake (fake = nothing leaves the machine)
WHATSAPP_MODE=live
CALENDAR_MODE=live
LLM_MODE=live

# --- Meta / WhatsApp
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=            # Embedded Signup configuration id
META_VERIFY_TOKEN=sparrow-verify
SPARROW_PHONE_NUMBER_ID=   # the Sparrow number (alerts to agents, "necesito ayuda")
SPARROW_WA_TOKEN=
SPARROW_WABA_ID=
# Dev/pilot: Meta's test number
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_TOKEN=

# --- Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The AI (azure_openai | openai | anthropic)
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5.4
AZURE_TRANSCRIBE_DEPLOYMENT=   # voice notes (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Pricing + Stripe (no STRIPE_PAYMENT_LINK = payment step skipped, free pilot)
INTEGRATION_FEE_EUR=90
MEETING_FEE_EUR=30
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=
